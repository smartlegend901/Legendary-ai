<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LEGEND AI | Supreme Edition</title>
    <!-- React & Babel for Browser Rendering -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Styling & Icons -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <style>
        body { 
            background-color: #050505; 
            color: #fef3c7; 
            font-family: 'Inter', sans-serif;
            margin: 0;
            overflow: hidden;
        }
        .legend-font { font-family: 'Cinzel', serif; }
        .gold-gradient { 
            background: linear-gradient(135deg, #fde047 0%, #ca8a04 50%, #854d0e 100%); 
        }
        .gold-border { 
            border: 1px solid rgba(202, 138, 4, 0.3); 
        }
        .gold-text {
            background: linear-gradient(to bottom right, #fef3c7, #fbbf24, #b45309);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .glass-panel {
            background: rgba(10, 10, 10, 0.8);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(202, 138, 4, 0.2);
        }
        .msg-shadow {
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }
        @keyframes glow {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 0.6; }
        }
        .animate-glow { animation: glow 3s ease-in-out infinite; }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // --- ICON COMPONENTS ---
        const GoldSparkle = () => (
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
        );

        const App = () => {
            const [messages, setMessages] = useState([
                { role: 'assistant', content: "Legendary frequencies established. I am online and tuned to your command.", time: "SYS_READY" }
            ]);
            const [input, setInput] = useState('');
            const [loading, setLoading] = useState(false);
            const scrollRef = useRef(null);

            // INPUT YOUR KEY HERE BEFORE DEPLOYING
            const apiKey = ""; 

            useEffect(() => {
                scrollRef.current?.scrollIntoView({ behavior: "smooth" });
            }, [messages]);

            const handleSend = async (e) => {
                e.preventDefault();
                if (!input.trim() || loading) return;

                const userMsg = input;
                setInput('');
                setMessages(prev => [...prev, { role: 'user', content: userMsg, time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) }]);
                setLoading(true);

                try {
                    const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ contents: [{ parts: [{ text: userMsg }] }] })
                    });
                    const data = await response.json();
                    const aiResult = data.candidates?.[0]?.content?.parts?.[0]?.text || "The signal is weak. Re-establish contact.";
                    setMessages(prev => [...prev, { role: 'assistant', content: aiResult, time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) }]);
                } catch (err) {
                    setMessages(prev => [...prev, { role: 'assistant', content: "Operational Error: Ensure your API Key is set in the source code.", time: "ERROR" }]);
                } finally {
                    setLoading(false);
                }
            };

            return (
                <div className="flex flex-col h-screen max-h-screen bg-[#050505] relative">
                    {/* Background Glow */}
                    <div className="absolute top-[-10%] left-[-10%] w-[50%] h-[40%] bg-yellow-900/10 blur-[100px] rounded-full animate-glow"></div>
                    
                    {/* Header */}
                    <header className="px-6 py-5 flex justify-between items-center border-b border-yellow-900/20 z-10 bg-black/40 backdrop-blur-md">
                        <div className="flex items-center gap-3">
                            <div className="w-9 h-9 gold-gradient rounded-xl flex items-center justify-center shadow-lg shadow-yellow-900/20">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                                </svg>
                            </div>
                            <div>
                                <h1 className="text-lg font-black tracking-widest gold-text legend-font leading-none">LEGEND</h1>
                                <p className="text-[8px] tracking-[0.4em] text-yellow-700 font-bold uppercase mt-1">Supreme Archive</p>
                            </div>
                        </div>
                        <div className="flex items-center gap-2">
                            <span className="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse shadow-[0_0_8px_#ca8a04]"></span>
                            <span className="text-[10px] font-bold text-yellow-800 tracking-tighter uppercase font-mono">LIVE_LINK</span>
                        </div>
                    </header>

                    {/* Messages Container */}
                    <div className="flex-1 overflow-y-auto px-4 py-6 space-y-8 scrollbar-hide">
                        {messages.map((msg, i) => (
                            <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'} animate-in fade-in slide-in-from-bottom-2`}>
                                <div className={`flex gap-3 max-w-[88%] ${msg.role === 'user' ? 'flex-row-reverse' : ''}`}>
                                    <div className={`mt-1 flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center border ${msg.role === 'user' ? 'bg-yellow-900/10 border-yellow-900/40' : 'bg-black/80 border-yellow-600/30'}`}>
                                        {msg.role === 'user' ? (
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" strokeWidth="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                        ) : <GoldSparkle />}
                                    </div>
                                    <div className="space-y-1">
                                        <div className={`p-4 rounded-2xl msg-shadow ${msg.role === 'user' ? 'bg-yellow-600/5 border border-yellow-600/20 text-yellow-50 rounded-tr-none' : 'bg-[#0f0f0f] border border-yellow-900/30 text-amber-50/90 rounded-tl-none'}`}>
                                            <p className="text-[14px] leading-relaxed tracking-wide font-light">{msg.content}</p>
                                        </div>
                                        <div className={`flex items-center gap-2 px-1 ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                                            <span className="text-[8px] font-bold text-yellow-900 tracking-widest uppercase">{msg.time}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                        {loading && (
                            <div className="flex justify-start animate-pulse">
                                <div className="p-4 bg-black/40 border border-yellow-900/20 rounded-2xl flex gap-1">
                                    <div className="w-1 h-1 bg-yellow-600 rounded-full animate-bounce"></div>
                                    <div className="w-1 h-1 bg-yellow-600 rounded-full animate-bounce delay-75"></div>
                                    <div className="w-1 h-1 bg-yellow-600 rounded-full animate-bounce delay-150"></div>
                                </div>
                            </div>
                        )}
                        <div ref={scrollRef} />
                    </div>

                    {/* Input System */}
                    <div className="glass-panel p-5 pb-8">
                        <form onSubmit={handleSend} className="max-w-xl mx-auto relative group">
                            <div className="absolute -inset-0.5 bg-yellow-600/20 blur opacity-0 group-focus-within:opacity-100 transition duration-500 rounded-2xl"></div>
                            <div className="relative flex items-center bg-[#0a0a0a] border border-yellow-900/40 rounded-2xl overflow-hidden focus-within:border-yellow-600/50 transition-all">
                                <input 
                                    type="text" 
                                    value={input}
                                    onChange={(e) => setInput(e.target.value)}
                                    placeholder="COMMAND THE LEGEND..."
                                    className="flex-1 bg-transparent px-5 py-4 text-sm text-yellow-50 focus:outline-none placeholder:text-yellow-900/40 font-mono tracking-widest"
                                />
                                <button type="submit" className="mr-2 p-3 gold-gradient rounded-xl text-black font-black active:scale-90 transition-transform shadow-lg">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
